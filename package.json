{
  "name": "lutriui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "i18n:emit": "bun scripts/emit-messages.ts",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --output-structure locale-modules --emit-ts-declarations --no-emit-git-ignore --no-emit-readme --no-emit-prettier-ignore",
    "dev": "bun run i18n:compile && vite",
    "app:dev": "bun run i18n:compile && tauri dev",
    "build": "bun run i18n:compile && tsc --noEmit && vite build",
    "app:build": "bun run i18n:compile && tauri build",
    "typecheck": "bun run i18n:compile && tsc --noEmit",
    "test": "bun run i18n:compile && bun test ./src",
    "gen:icon": "bun scripts/gen-icon.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.26.0",
    "@inlang/plugin-message-format": "^4.4.5",
    "@phosphor-icons/react": "^2.1.7",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
